# FlowBoard - Environment Variables (Same Keys for Local and Production, Only URLs Differ)
# Copy this file to .env (local) or set same values in MonsterASP.net App Settings + Vercel Env Vars for Production
# You will provide these 5 keys once - use SAME value for local and prod

# === Upstash Redis (from console.upstash.com -> TCP -> REDIS_URL rediss://default:password@host:6379) ===
# Used by: Gateway (rate limit) + Project.Service (board cache + distributed lock) + Notification (online set + backplane)
# Same key for local and prod - local backend connects to cloud Redis directly via rediss://
Redis__Connection=rediss://default:PASTE_YOUR_UPSTASH_REDIS_PASSWORD@unbiased-puma-160813.upstash.io:6379

# === CloudAMQP RabbitMQ (from cloudamqp.com -> Details -> AMQP URL amqps://user:pass@host/vhost) ===
# Used by: Project.Service (publish TaskMoved etc. via MassTransit) -> Notification.Service (consume)
# Same key local/prod - local backend publishes to cloud RabbitMQ directly
RabbitMQ__Host=amqps://PASTE_YOUR_CLOUDAMQP_USER:PASSWORD@puffin.rmq2.cloudamqp.com/vhost

# === Cloudinary (from console.cloudinary.com -> Dashboard -> Cloud name, API Key, API Secret) ===
# Used by: File.Service (signed upload to folder flowboard/{workspaceId}/{projectId}/{taskId})
Cloudinary__CloudName=PASTE_YOUR_CLOUDINARY_CLOUD_NAME
Cloudinary__ApiKey=PASTE_YOUR_CLOUDINARY_API_KEY
Cloudinary__ApiSecret=PASTE_YOUR_CLOUDINARY_API_SECRET

# === Brevo Transactional API (from app.brevo.com -> Settings -> SMTP & API -> API Keys -> xkeysib-...) ===
# Used by: Identity.Service (invite member/client), Notification.Service (TaskAssigned email)
# Free 300/day, same key local/prod
Brevo__ApiKey=xkeysib-PASTE_YOUR_BREVO_API_KEY

# === Gemini AI (from aistudio.google.com/app/apikey -> Create API key -> AIza...) ===
# Used by: Project.Service (POST /api/tasks/ai-generate via Gemini 2.5 Flash - 15 RPM, 1M TPM, 1500 RPD)
# Same key local/prod, no fallback
Gemini__ApiKey=AIzaSyPASTE_YOUR_GEMINI_API_KEY

# === JWT (generate locally, same for local/prod - 32+ chars, HS256) ===
# Used by: Identity.Service (issue) + Gateway.YARP + All Services (validate)
# Generate via: powershell -Command "[System.Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) )"
Jwt__Key=PASTE_SUPER_SECRET_32_CHARS_MINIMUM_FOR_HS256
Jwt__Issuer=FlowBoard.Identity
Jwt__Audience=FlowBoard.Gateway

# === SQL Server (MonsterASP.net or LocalDB) ===
# Local: Server=localhost;Database=flowboard;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
# Production: Server=mssql.monsterasp.net;Database=flowboard;User Id=xxx;Password=xxx;
ConnectionStrings__Default=Server=localhost;Database=flowboard;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# === Frontend (Angular 22) - Only URLs Differ, Keys Same ===
# Local: NG_APP_API_URL=http://localhost:5000, NG_APP_HUB_URL=http://localhost:5004/hubs/board
# Production: NG_APP_API_URL=https://gateway-xxxxx.monsterasp.net, NG_APP_HUB_URL=https://notify-xxxxx.monsterasp.net/hubs/board
# Vercel Env Vars: NG_APP_API_URL, NG_APP_HUB_URL (set in Vercel dashboard)
# Angular environments: frontend/flowboard-web/src/environments/environment.ts (local) vs environment.prod.ts (prod)

