{
  "_comment": "YARP Gateway config - Routes map public paths (Angular calls http://localhost:5000/api/*) to microservices (5001-5004). Clusters define destinations. See Gateway.YARP/Program.cs AddReverseProxy().LoadFromConfig() - JSON does not support // comments, so this _comment field explains it. Local: http://localhost:5001-5004, Prod (Task 5.4): https://*-xxxxx.monsterasp.net",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "workspace-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/workspaces/{**catch-all}" },
        "Order": 1
      },
      "org-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/organizations/{**catch-all}" }
      },
      "project-route": {
        "ClusterId": "project-cluster",
        "Match": { "Path": "/api/workspaces/{workspaceId}/projects/{**catch-all}" },
        "Order": 0
      },
      "project-workspace-route": {
        "ClusterId": "project-cluster",
        "Match": { "Path": "/api/workspaces/{workspaceId}/projects" },
        "Order": 0
      },
      "project-api-route": {
        "ClusterId": "project-cluster",
        "Match": { "Path": "/api/projects/{**catch-all}" }
      },
      "task-route": {
        "ClusterId": "project-cluster",
        "Match": { "Path": "/api/tasks/{**catch-all}" },
        "Order": 1
      },
      "file-route": {
        "ClusterId": "file-cluster",
        "Match": { "Path": "/api/files/{**catch-all}" }
      },
      "file-attachments-route": {
        "ClusterId": "file-cluster",
        "Match": { "Path": "/api/tasks/{taskId}/attachments" }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "hub-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": { "Address": "http://localhost:5001" }
        }
      },
      "project-cluster": {
        "Destinations": {
          "project": { "Address": "http://localhost:5002" }
        }
      },
      "file-cluster": {
        "Destinations": {
          "file": { "Address": "http://localhost:5003" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": { "Address": "http://localhost:5004" }
        }
      }
    }
  }
}
